# Frontend (Next.js on Vercel)
# Local: leave as localhost. Production: set in Vercel → Settings → Environment Variables.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Set to "false" to hide Google sign-in when OAuth is not configured
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# Production example (Vercel dashboard — Production + Preview):
# NEXT_PUBLIC_API_URL=https://YOUR-API.onrender.com/api/v1
# FRONTEND_URL on backend must be https://ai-outreach-frontend-ten.vercel.app
